        "jsCode": "const all=$input.all().map(x=>x.json);\nif(!all.length || all.some(x=>x.acknowledged!==true)) throw new Error('CSV upload acknowledgement failed');\nconst id=all[0].run_id;\nif(all.some(x=>x.run_id!==id)) throw new Error('Mixed run IDs');\nreturn [{json:{run_id:id,upload_acknowledgements:all.length}}];"
