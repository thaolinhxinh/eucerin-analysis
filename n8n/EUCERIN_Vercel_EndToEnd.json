      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Edit ONLY these four non-secret values. Store API key in n8n Header Auth credential.\nconst cfg = {\n  apiBaseUrl: 'https://eucerin-ml-automation.vercel.app',\n  sourceFileId: 'REPLACE_WITH_SOURCE_CSV_FILE_ID',\n  outputFolderId: 'REPLACE_WITH_OUTPUT_FOLDER_ID',\n  telegramChatId: 'REPLACE_WITH_TELEGRAM_CHAT_ID',\n};\nfor (const [k,v] of Object.entries(cfg)) {\n  if (!v || v.includes('REPLACE_WITH_')) throw new Error('Configure '+k+' in this Code node first');\n}\nif (!/^https:\\/\\/[^/]+$/.test(cfg.apiBaseUrl)) throw new Error('apiBaseUrl must be HTTPS without trailing slash');\nreturn [{json:cfg}];"
      },
