    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json;\nif(!x || !x.run_id || !Array.isArray(x.files_pending)) throw new Error('No pending artifact list');\nconst allowed=['FactOccurrenceForecast_PowerBI.csv','DimSKU_Behavior.csv','DimDate_Extended_For_Forecast.csv','Model_Validation_Metrics.csv','Model_Holdout_Metrics.csv','Model_Run_History.csv','Monitoring_Daily_PowerBI.csv','SKU_Monitoring_Alerts.csv'];\nfor(const f of x.files_pending){if(!allowed.includes(f)) throw new Error('Unexpected artifact '+f);}\nreturn x.files_pending.map(f=>({json:{run_id:x.run_id,file_name:f,drive_name:x.run_id+'__'+f},pairedItem:{item:0}}));"
      },
