      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const file=$input.first()?.json || {};\nconst id=String(file.id||'');\nconst revision=String(file.md5Checksum || file.modifiedTime || file.version || '');\nif (!id || !revision) throw new Error('Google Drive metadata needs id + md5Checksum/modifiedTime/version. Inspect Drive Get node output.');\nif (file.mimeType && file.mimeType !== 'text/csv' && file.mimeType !== 'application/vnd.ms-excel' && file.mimeType !== 'application/octet-stream') {\n throw new Error('Expected uploaded CSV, not Google Sheet or document. Export CSV first.');\n}\nreturn [{json:{...file, revision}}];"
      },
